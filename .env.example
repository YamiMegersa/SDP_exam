# ARL operations platform - configuration.
# Copy to .env and fill in the values for your environment.
# The platform reads only these variables; no credentials are stored in code.

# --- MQTT broker (required) -------------------------------------------------
MQTT_BROKER_ADDRESS=localhost
MQTT_BROKER_PORT=1883
# Leave empty for an anonymous broker (the local test deployment).
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=

# --- ARL API (required) -----------------------------------------------------
ARL_API_ADDRESS=localhost
ARL_API_PORT=8080

# --- Platform (optional) ----------------------------------------------------
PORT=3000
DB_PATH=./data/arl.sqlite
ARL_SERVICES=rta,mhe,opg
ARL_API_TIMEOUT_MS=5000
RESEARCHER_CACHE_TTL_S=60
TELEMETRY_BATCH_MS=250
TELEMETRY_BATCH_ROWS=1000
